rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Roles del equipo: documento staff/{uid} con { role: "admin" | "operator" }.
    // No hay Cloud Functions/Admin SDK, así que el primer admin se crea a
    // mano (consola de Firebase o emulador); desde ahí, un admin puede
    // gestionar al resto desde la app.
    function isStaff() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == "admin";
    }

    match /staff/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // El ID del documento de cliente es el token aleatorio del enlace.
    // El público solo puede pedir UN documento por su ID exacto (get);
    // nunca puede listar/enumerar la colección.
    match /clients/{clientId} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if isStaff();
      // Editar la info base del cliente (nombre, plan, fecha de alta,
      // campos extra, saldo) es solo de admin. El operador solo puede
      // tocar status/endedAt (retirar/reactivar) — nunca el resto.
      allow update: if isAdmin() ||
        (isStaff() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "endedAt"]));
      allow delete: if isAdmin();

      // Subcolección de pagos: para listarla hace falta conocer el
      // clientId exacto (va en la ruta), igual que para leer el cliente.
      // Así un cliente público nunca puede ver pagos de otro clientId.
      match /payments/{paymentId} {
        allow get, list: if true;
        allow create, update: if isStaff();
        // Borrar un pago es una corrección financiera — solo admin, a
        // diferencia de crear/editar que sigue abierto al operador.
        allow delete: if isAdmin();
      }
    }

    // Planes: catálogo no sensible (nombre/monto/ciclo), legible por
    // cualquiera para que el panel público pueda resolver el saldo.
    match /plans/{planId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Configuración de la vertical: no es dato de negocio sensible.
    match /config/{configId} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
