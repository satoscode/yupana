{
  "name": "yupana",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-yupana \"vitest run --config vitest.rules.config.js\"",
    "seed": "node scripts/seed-water-demo.js",
    "seed:emulator": "node scripts/seed-water-demo-emulator.js",
    "dev:emulator": "concurrently --success first \"firebase emulators:start --only firestore,auth --project demo-yupana\" \"wait-on tcp:8080 tcp:9099 && npm run seed:emulator\" \"wait-on tcp:8080 && cross-env VITE_USE_FIREBASE_EMULATOR=true vite\""
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "firebase-admin": "^14.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.4",
    "wait-on": "^8.0.1"
  }
}
